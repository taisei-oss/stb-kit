<?xml version="1.0" encoding="UTF-8"?>
<ST_BRIDGE xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="2.0.2" xmlns="https://www.building-smart.or.jp/dl">
  <StbCommon project_name="test" app_name="stbkit-core" app_version="0.0.0" />
  <StbModel>
    <StbNodes>
      <StbNode id="1" X="0" Y="0" Z="0" kind="ON_GRID" />
      <StbNode id="2" X="0" Y="0" Z="5000" kind="ON_GRID" />
      <StbNode id="3" X="5000" Y="0" Z="0" kind="ON_GRID" />
      <StbNode id="4" X="5000" Y="0" Z="5000" kind="ON_GRID" />
    </StbNodes>
    <StbMembers>
      <StbColumns>
        <StbColumn id="1" name="C1" id_node_bottom="1" id_node_top="2" id_section="1" kind_structure="CFT" />
        <StbColumn id="2" name="C2" id_node_bottom="3" id_node_top="4" id_section="2" kind_structure="CFT" joint_bottom="1000"/>
      </StbColumns>
    </StbMembers>
    <StbSections>
      <StbSecColumn_CFT id="1" name="C1">
        <StbSecSteelFigureColumn_CFT>
          <StbSecSteelColumn_CFT_Same shape="BB-500x600x22x25" strength="SN400" />
        </StbSecSteelFigureColumn_CFT>
      </StbSecColumn_CFT>
      <StbSecColumn_CFT id="2" name="C2">
        <StbSecSteelFigureColumn_CFT>
          <StbSecSteelColumn_CFT_NotSame pos="BOTTOM" shape="P-500x50" strength="SN400" />
          <StbSecSteelColumn_CFT_NotSame pos="TOP" shape="P-500x12" strength="SN400" />
        </StbSecSteelFigureColumn_CFT>
      </StbSecColumn_CFT>
      <StbSecSteel>
        <StbSecBuild-BOX name="BB-500x600x22x25" A="500" B="600" t1="22" t2="25" />
        <StbSecPipe name="P-500x12" D="500" t="12" />
        <StbSecPipe name="P-500x50" D="500" t="50" />
      </StbSecSteel>
    </StbSections>
  </StbModel>
</ST_BRIDGE>